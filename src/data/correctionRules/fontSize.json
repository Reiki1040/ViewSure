{
  "id": "font-size-rules",
  "name": "フォントサイズ修正ルール",
  "description": "テキストのフォントサイズをWCAG基準に適合させるための修正ルール",
  "version": "1.0.0",
  "rules": [
    {
      "id": "heading-font-size-error",
      "issueType": "font-size",
      "severity": "error",
      "condition": {
        "elementType": "heading",
        "fontSize": { "lt": 28 }
      },
      "actions": [
        {
          "type": "fontSize",
          "priority": "high",
          "parameters": {
            "strategy": "scale-to-minimum",
            "minimumSize": 28,
            "scaleFactor": 1.2
          },
          "description": "見出しのフォントサイズを28pt以上に引き上げます"
        }
      ]
    },
    {
      "id": "body-font-size-error",
      "issueType": "font-size",
      "severity": "error",
      "condition": {
        "elementType": "body",
        "fontSize": { "lt": 18 }
      },
      "actions": [
        {
          "type": "fontSize",
          "priority": "high",
          "parameters": {
            "strategy": "scale-to-minimum",
            "minimumSize": 18,
            "scaleFactor": 1.1
          },
          "description": "本文のフォントサイズを18pt以上に引き上げます"
        }
      ]
    },
    {
      "id": "heading-font-size-warning",
      "issueType": "font-size",
      "severity": "warning",
      "condition": {
        "elementType": "heading",
        "fontSize": { "gte": 28, "lt": 32 }
      },
      "actions": [
        {
          "type": "fontSize",
          "priority": "medium",
          "parameters": {
            "strategy": "scale-to-optimal",
            "optimalSize": 32,
            "scaleFactor": 1.1
          },
          "description": "見出しのフォントサイズを32ptに引き上げることを推奨します"
        }
      ]
    },
    {
      "id": "body-font-size-warning",
      "issueType": "font-size",
      "severity": "warning",
      "condition": {
        "elementType": "body",
        "fontSize": { "gte": 18, "lt": 20 }
      },
      "actions": [
        {
          "type": "fontSize",
          "priority": "medium",
          "parameters": {
            "strategy": "scale-to-optimal",
            "optimalSize": 20,
            "scaleFactor": 1.05
          },
          "description": "本文のフォントサイズを20ptに引き上げることを推奨します"
        }
      ]
    },
    {
      "id": "caption-font-size-error",
      "issueType": "font-size",
      "severity": "error",
      "condition": {
        "elementType": "caption",
        "fontSize": { "lt": 14 }
      },
      "actions": [
        {
          "type": "fontSize",
          "priority": "medium",
          "parameters": {
            "strategy": "scale-to-minimum",
            "minimumSize": 14,
            "scaleFactor": 1.1
          },
          "description": "キャプションのフォントサイズを14pt以上に引き上げます"
        }
      ]
    },
    {
      "id": "footer-font-size-error",
      "issueType": "font-size",
      "severity": "warning",
      "condition": {
        "elementType": "footer",
        "fontSize": { "lt": 12 }
      },
      "actions": [
        {
          "type": "fontSize",
          "priority": "low",
          "parameters": {
            "strategy": "scale-to-minimum",
            "minimumSize": 12,
            "scaleFactor": 1.1
          },
          "description": "フッターのフォントサイズを12pt以上に引き上げます"
        }
      ]
    }
  ],
  "sizeGuidelines": {
    "heading": {
      "h1": { "minimum": 44, "optimal": 48, "maximum": 72 },
      "h2": { "minimum": 36, "optimal": 40, "maximum": 60 },
      "h3": { "minimum": 28, "optimal": 32, "maximum": 48 }
    },
    "body": {
      "minimum": 18,
      "optimal": 20,
      "maximum": 32
    },
    "caption": {
      "minimum": 14,
      "optimal": 16,
      "maximum": 20
    },
    "footer": {
      "minimum": 12,
      "optimal": 14,
      "maximum": 16
    }
  },
  "strategies": {
    "scale-to-minimum": {
      "description": "最小サイズまでフォントをスケーリング",
      "steps": [
        "現在のフォントサイズを取得",
        "最小サイズとの比率を計算",
        "比率に基づいてフォントサイズを調整",
        "レイアウトへの影響を評価"
      ]
    },
    "scale-to-optimal": {
      "description": "最適サイズまでフォントをスケーリング",
      "steps": [
        "現在のフォントサイズを取得",
        "最適サイズとの比率を計算",
        "比率に基づいてフォントサイズを調整",
        "テキストのオーバーフローをチェック"
      ]
    },
    "proportional-scale": {
      "description": "要素の階層に基づいて比例的にスケーリング",
      "steps": [
        "要素の階層レベルを特定",
        "基本サイズに対する比率を計算",
        "階層に応じたスケーリングを適用",
        "一貫性を確認"
      ]
    }
  },
  "fontFamilies": {
    "accessible": [
      "Arial, sans-serif",
      "Helvetica, sans-serif",
      "Verdana, sans-serif",
      "Tahoma, sans-serif",
      "Trebuchet MS, sans-serif",
      "Times New Roman, serif",
      "Georgia, serif",
      "Palatino, serif",
      "Courier New, monospace",
      "Lucida Console, monospace"
    ],
    "avoid": [
      "Comic Sans",
      "Impact",
      "Brush Script"
    ]
  },
  "lineHeight": {
    "minimum": 1.2,
    "optimal": 1.5,
    "maximum": 2.0,
    "heading": {
      "minimum": 1.1,
      "optimal": 1.2,
      "maximum": 1.4
    }
  }
}